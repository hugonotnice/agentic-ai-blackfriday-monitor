# PriceBuddy Container Configuration (copy to .env and replace placeholders)
APP_NAME="Agentic Black Friday Monitor"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_ARTISAN_KEY_GENERATE_OUTPUT
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database/database.sqlite

SCRAPER_BASE_URL=http://scraper:3000
AFFILIATE_ENABLED=false

# Initial admin credentials created on first boot (change immediately)
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=change-me-local-password
