# Harness & Alerting Configuration (copy to harness.env and fill in your values)
PRICEBUDDY_URL=http://127.0.0.1:8080
PRICEBUDDY_API_TOKEN=replace-with-sanctum-token
PRICEBUDDY_CONTAINER=bf-pricebuddy
SCRAPER_URL=http://127.0.0.1:3035

HARNESS_DB=./storage/harness.sqlite

# Telegram Bot Notifications (optional; leave blank to run dashboard-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=

# Comma-separated public Telegram deal channel slugs (t.me/s/<slug>)
TELEGRAM_CHANNELS=pelandobr,promobit,hardmoboficial,benchpromos,promotop,pechinchou,economizzando

# Optional extra .env file path to inherit bot credentials from
EXTRA_ENV_PATH=

# Adaptive polling schedule dates (YYYY-MM-DD)
PEAK_START_DATE=2026-11-26
CUTOFF_DATE=2026-12-02
TIMEZONE_OFFSET_HOURS=-3
